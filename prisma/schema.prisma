generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  password        String
  roles           Role
  money           Int              @default(0)
  status          UserStatus       @default(active)
  created_at      DateTime         @default(now())
  active_token    String?          // nullable token
  is_deleted      Int              @default(0)

  //Relationships
  chargeHistories ChargeHistory[]  @relation("UserChargeHistories")
  approvedHistories  ChargeHistory[]   @relation("ApprovedByUser")
  bettingRounds   BettingRound[]      // Relation to BettingRound
}

model ChargeHistory {
  id      Int   @id @default(autoincrement())
  user_id Int
  amount  Int   @default(0)
  status  Int   @default(0) // 0: pending, 1: approve, 2: cancel, 3: hold
  created_at    DateTime @default(now())
  before_money Int @default(0)
  after_money Int @default(0)
  approved_at   DateTime?
  approved_by  Int?

  //Relationships
  user    User  @relation("UserChargeHistories", fields: [user_id], references: [id])
  approvedBy   User?     @relation("ApprovedByUser", fields: [approved_by], references: [id])
}

model BettingRound{
  id Int @id @default(autoincrement())
  user_id Int
  game_name String
  betting_amount Int @default(0)
  winning_amount Int @default(0)
  betting_status Int @default(0) // 0: pending, 1: lose, 2: win, 3: draw  
  round_id String
  bet_type String?


  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  //Relationship
  user    User @relation(fields: [user_id], references: [id])

}


//ENUMS

enum Role {
  user
  admin
  test_player
  developer
}

enum UserStatus {
  active
  withdrawn
  suspended
}
